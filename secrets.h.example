// ============================================================
// secrets.h.example — template for LoRaWAN credentials
// Copy this file to secrets.h and fill in your own values
// from the ChirpStack console (Applications > Devices > your device).
// secrets.h itself is gitignored and must never be committed.
// ============================================================
#pragma once

// Device EUI — unique ID for this device, assigned/printed on the CubeCell
uint8_t devEui[] = { 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00 };

// App EUI / Join EUI — identifies the application this device joins
uint8_t appEui[] = { 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00 };

// App Key — secret used during OTAA join to derive session keys
uint8_t appKey[] = { 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
                     0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00 };

// The following are only used for ABP (manual activation) instead of
// OTAA (automatic join). Leave as zero if you're using OTAA above.
uint32_t devAddr = 0x00000000;
uint8_t  nwkSKey[] = { 0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,
                        0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00 };
uint8_t  appSKey[] = { 0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,
                        0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00 };
